{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "tsconfigFile": "tsconfig.json",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "clearTextReporter": { "maxTestsToLog": 3 },
  "_comment": "Mutation testing measures whether the suite kills injected faults in the runtime, compiler, built-in functions, and checker, not just whether those lines run.",
  "mutate": [
    "src/runtime/values.ts",
    "src/runtime/state.ts",
    "src/compile/compiler.ts",
    "src/functions/builtins.ts",
    "src/check/checker.ts"
  ],
  "thresholds": { "high": 95, "low": 87, "break": 87 }
}
