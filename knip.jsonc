{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Entry points that legitimately "consume" code. The published package entries
  // (src/index.ts, src/service/index.ts) are detected automatically from the
  // package.json "exports" field, so only the non-src graphs are listed here.
  // Including them means their imports count as usage, so devDependencies used
  // only by tests or scripts are not falsely reported as unused.
  "entry": [
    "tests/**/*.test.ts",
    "scripts/*.ts"
    // website/.vitepress lives under a dot-directory knip does not match, so a
    // website entry pattern only produces a "no matches" hint.
  ],
  "project": ["src/**/*.ts"],
  // npm is consumed by the release workflow, which knip does not trace. It
  // remains a devDependency so CI executes a lockfile-pinned, integrity-checked
  // binary instead of a registry fallback (OSSF Scorecard Pinned-Dependencies).
  "ignoreDependencies": ["npm"],
  "rules": {
    // Unused *value* exports are real dead code and fail the gate. Unused *type*
    // exports are not: for a parser library the exported AST/error interfaces are
    // a public contract for consumers typing parse() output, even when nothing
    // imports them internally. Reporting them would be noise, so type-export
    // analysis is disabled rather than worked around per-symbol.
    "types": "off"
  }
}
