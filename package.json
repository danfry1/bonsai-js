{
  "name": "bonsai-js",
  "version": "0.5.0",
  "description": "A safe, zero-dependency expression language for rules, filters, and templates",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./service": {
      "types": "./dist/service/index.d.mts",
      "import": "./dist/service/index.mjs",
      "default": "./dist/service/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danfry1/bonsai-js.git"
  },
  "homepage": "https://danfry1.github.io/bonsai-js/",
  "bugs": {
    "url": "https://github.com/danfry1/bonsai-js/issues"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "bench:gate": "bun run scripts/perf-gate.ts",
    "bench:compare": "bun run scripts/perf-compare.ts",
    "check:package": "bun run build && bun run scripts/check-package.ts",
    "check:release": "bun run format:check && bun run lint && bun run knip && bun run typecheck && bun run test:coverage && bun run bench:gate && bun run check:package",
    "lint": "oxlint --type-aware --deny-warnings src tests scripts",
    "format": "oxfmt src tests scripts tsdown.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src tests scripts tsdown.config.ts vitest.config.ts",
    "knip": "knip",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "dev:website": "vitepress dev website",
    "build:website": "vitepress build website",
    "preview:website": "vitepress preview website",
    "prepare": "test -n \"$CI\" || lefthook install",
    "prepublishOnly": "bun run check:release",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "bun run test:mutation:core",
    "test:mutation:core": "stryker run stryker.config.json",
    "fuzz": "bun run scripts/fuzz.ts",
    "cost-fuzz": "bun run scripts/cost-fuzz.ts",
    "check:bump": "bumpy check",
    "bump": "bumpy add",
    "bump:generate": "bumpy generate",
    "bump:version": "bumpy version"
  },
  "keywords": [
    "expression",
    "evaluator",
    "parser",
    "safe",
    "sandbox",
    "template",
    "transform",
    "formula",
    "dsl",
    "ast",
    "jexl",
    "compiler"
  ],
  "author": "Daniel Fry",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@fast-check/vitest": "0.5.0",
    "@marcbachmann/cel-js": "8.0.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.20.5",
    "@varlock/bumpy": "1.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.10.2",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "npm": "11.19.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "0.24.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.9",
    "fast-uri": "3.1.8",
    "smol-toml": "1.8.0",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2",
    "vite": "7.3.6",
    "vue": "3.5.43"
  }
}
