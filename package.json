{
  "name": "bonsai-js",
  "version": "0.4.0",
  "description": "A safe, zero-dependency expression language for rules, filters, and templates",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./stdlib": {
      "types": "./dist/stdlib/index.d.mts",
      "import": "./dist/stdlib/index.mjs"
    },
    "./autocomplete": {
      "types": "./dist/autocomplete/index.d.mts",
      "import": "./dist/autocomplete/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danfry1/bonsai-js.git"
  },
  "homepage": "https://danfry1.github.io/bonsai-js/",
  "bugs": {
    "url": "https://github.com/danfry1/bonsai-js/issues"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "bench:gate": "bun run scripts/perf-gate.ts",
    "check:package": "bun run build && bun run scripts/check-package.ts",
    "lint": "oxlint --deny-warnings src tests scripts",
    "knip": "knip",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "build:website": "bun website/build.ts",
    "prepare": "test -n \"$CI\" || lefthook install",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run test && bun run bench:gate && bun run check:package",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "expression",
    "evaluator",
    "parser",
    "safe",
    "sandbox",
    "template",
    "pipe",
    "transform",
    "formula",
    "dsl",
    "ast",
    "jexl",
    "compiler"
  ],
  "author": "Daniel Fry",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@fast-check/vitest": "0.4.1",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.7",
    "fast-check": "4.8.0",
    "jexl": "2.3.0",
    "knip": "6.14.2",
    "lefthook": "2.1.8",
    "oxlint": "1.67.0",
    "tsdown": "0.22.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "overrides": {
    "vite": "7.3.3",
    "postcss": "8.5.11",
    "picomatch": "4.0.4"
  }
}
