{
  "name": "bonsai-js",
  "version": "1.2.0",
  "description": "A safe, zero-dependency expression language for rules, filters, and templates",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "lite": [
        "./dist/lite/index.d.mts"
      ],
      "service": [
        "./dist/service/index.d.mts"
      ],
      "query": [
        "./dist/query/index.d.mts"
      ],
      "runtime": [
        "./dist/runtime/index.d.mts"
      ],
      "runtime/core": [
        "./dist/runtime/core.d.mts"
      ],
      "builtins": [
        "./dist/builtins/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./lite": {
      "types": "./dist/lite/index.d.mts",
      "import": "./dist/lite/index.mjs",
      "default": "./dist/lite/index.mjs"
    },
    "./service": {
      "types": "./dist/service/index.d.mts",
      "import": "./dist/service/index.mjs",
      "default": "./dist/service/index.mjs"
    },
    "./query": {
      "types": "./dist/query/index.d.mts",
      "import": "./dist/query/index.mjs",
      "default": "./dist/query/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.mts",
      "import": "./dist/runtime/index.mjs",
      "default": "./dist/runtime/index.mjs"
    },
    "./runtime/core": {
      "types": "./dist/runtime/core.d.mts",
      "import": "./dist/runtime/core.mjs",
      "default": "./dist/runtime/core.mjs"
    },
    "./builtins": {
      "types": "./dist/builtins/index.d.mts",
      "import": "./dist/builtins/index.mjs",
      "default": "./dist/builtins/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danfry1/bonsai-js.git"
  },
  "homepage": "https://danfry1.github.io/bonsai-js/",
  "bugs": {
    "url": "https://github.com/danfry1/bonsai-js/issues"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:servers": "QUERY_SERVERS=1 vitest run tests/query.servers.test.ts",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "bench:gate": "bun run scripts/perf-gate.ts",
    "bench:compare": "bun run scripts/perf-compare.ts",
    "check:package": "bun run build && bun run scripts/check-package.ts",
    "check:size": "bun run scripts/size-budget.ts",
    "check:docs": "bun run website/scripts/check-examples.ts && bun run website/scripts/check-components.ts",
    "check:release": "bun run format:check && bun run lint && bun run knip && bun run typecheck && bun run check:docs && bun run test:coverage && bun run bench:gate && bun run check:package && bun run check:size",
    "lint": "oxlint --type-aware --deny-warnings src tests scripts",
    "format": "oxfmt src tests scripts tsdown.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src tests scripts tsdown.config.ts vitest.config.ts",
    "knip": "knip",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "dev:website": "vitepress dev website",
    "build:website": "vitepress build website",
    "preview:website": "vitepress preview website",
    "prepare": "test -n \"$CI\" || lefthook install",
    "prepublishOnly": "bun run check:release",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "bun run test:mutation:core",
    "test:mutation:core": "stryker run stryker.config.json",
    "fuzz": "bun run scripts/fuzz.ts",
    "cost-fuzz": "bun run scripts/cost-fuzz.ts",
    "cross-fuzz": "bun run scripts/cross-fuzz.ts",
    "check:bump": "bumpy check",
    "bump": "bumpy add",
    "bump:generate": "bumpy generate",
    "bump:version": "bumpy version"
  },
  "keywords": [
    "expression",
    "evaluator",
    "parser",
    "safe",
    "sandbox",
    "template",
    "transform",
    "formula",
    "dsl",
    "ast",
    "jexl",
    "cel",
    "compiler",
    "rules",
    "rules-engine",
    "filter",
    "typescript",
    "sql",
    "mongodb"
  ],
  "author": "Daniel Fry",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@electric-sql/pglite": "0.5.10",
    "@fast-check/vitest": "0.5.0",
    "@marcbachmann/cel-js": "8.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@varlock/bumpy": "1.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.2",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "mingo": "7.2.5",
    "mongodb": "7.7.0",
    "npm": "11.19.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitest": "4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.9",
    "fast-uri": "3.1.8",
    "smol-toml": "1.8.0",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2",
    "vite": "7.3.7",
    "vue": "3.5.43"
  }
}
